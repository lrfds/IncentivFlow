# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incentivflow"

# Auth
JWT_SECRET="change-me-in-production"
WEB_URL="http://localhost:5173"
LOG_LEVEL="info"

# SERPRO - OAuth2 client_credentials
# Use as credenciais obtidas no Portal do Estaleiro SERPRO.
SERPRO_CLIENT_ID="seu_client_id_aqui"
SERPRO_CLIENT_SECRET="seu_client_secret_aqui"

# homologacao | producao
SERPRO_ENV="homologacao"

# Opcional: sobrescreva as URLs padrão se seu contrato usar gateways específicos.
# SERPRO_TOKEN_URL="https://gateway.apiserpro.serpro.gov.br/token"
# SERPRO_CNPJ_BASICA_URL="https://gateway.apiserpro.serpro.gov.br/api-cnpj-basica/v2/basica"
# SERPRO_CNPJ_QSA_URL="https://gateway.apiserpro.serpro.gov.br/api-cnpj-qsa/v2/qsa"
# SERPRO_CNPJ_EMPRESA_URL="https://gateway.apiserpro.serpro.gov.br/api-cnpj-empresa/v2/empresa"
# SERPRO_GATEWAY_URL_HOMOLOGACAO="https://gateway.apiserpro.serpro.gov.br"
# SERPRO_GATEWAY_URL_PRODUCAO="https://gateway.apiserpro.serpro.gov.br"

# Compatibilidade legada (opcional)
# SERPRO_CONSUMER_KEY="..."
# SERPRO_CONSUMER_SECRET="..."
